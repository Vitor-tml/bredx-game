@startuml Diagrama
!theme cyborg-outline
skinparam classAttributeIconSize 0
skinparam backgroundColor #1e1e1e
skinparam defaultFontColor #ffffff
skinparam shadowing false

' Cores específicas para diferentes tipos de classes
skinparam class {
    ArrowColor #4a9eff
    FontColor #ffffff
}

' MANAGERS - Azul (Singletons e Gerenciadores)
skinparam class<<Manager>> {
    BackgroundColor #1f4e79
    BorderColor #4a9eff
    FontColor #ffffff
    HeaderBackgroundColor #2d5aa0
}

' COMPONENTS - Verde (Componentes reutilizáveis)
skinparam class<<Component>> {
    BackgroundColor #2d5a3d
    BorderColor #4caf50
    FontColor #ffffff
    HeaderBackgroundColor #388e3c
}

' ENTITIES - Laranja (Entidades do jogo)
skinparam class<<Entity>> {
    BackgroundColor #664228
    BorderColor #ff9800
    FontColor #ffffff
    HeaderBackgroundColor #8d5a00
}

' SCENES - Roxo (Cenas e interface)
skinparam class<<Scene>> {
    BackgroundColor #4a2c5a
    BorderColor #9c27b0
    FontColor #ffffff
    HeaderBackgroundColor #7b1fa2
}

' UTILITIES - Cinza (Utilitários e auxiliares)
skinparam class<<Utility>> {
    BackgroundColor #424242
    BorderColor #757575
    FontColor #ffffff
    HeaderBackgroundColor #616161
}

' BASE CLASSES - Vermelho escuro (Classes base abstratas)
skinparam class<<Abstract>> {
    BackgroundColor #5d2e2e
    BorderColor #e57373
    FontColor #ffffff
    HeaderBackgroundColor #8e0000
}

skinparam note {
    BackgroundColor #3a3a3a
    BorderColor #4a9eff
    FontColor #ffffff
}

skinparam stereotype {
    CBackgroundColor #4a9eff
    CFontColor #000000
}

' ===================
' GERENCIADOR DE NIVEL
' ===================

class Level {
    - mapa : TileMap
    - lEntidades : vector<Entity*>
    - texturas : Sprites
    - sons : Sounds 
    - musica : Music
    - cenario : 
    + carragerTexturas()
    + carregarSons()
    + carregarMapa()
    + inicializar()
    + finalizar()
    + carregarEntidades()
}

namespace Gerenciador {

    class LevelManager <<Manager>> {
        - {static} singleton: LevelManager*
        - lNives : unordered_map
        
    }
}
' ===================
' NAMESPACE GERENCIADOR
' ===================
namespace Gerenciador {
    
    class Renderer <<Manager>> {
        - {static} singleton: Renderer*
        - janela: sf::RenderWindow
        - camera: sf::View
        - drawables: vector<pair<Drawable*, int>>
        - shader: sf::Shader
        - shaderCarregado: bool
        - isShader: bool
        - caixaDeMovimento: sf::FloatRect
        - Renderer(largura: int, altura: int, titulo: string)
        - ~Renderer()
        + {static} getInstance(largura: int, altura: int, titulo: string): Renderer*
        + addDrawable(drawable: sf::Drawable&, camada: int)
        + clearDrawables()
        + render()
        + isOpen(): bool
        + close()
        + moveCamera(x: float, y: float)
        + setCentroCamera(x: float, y: float)
        + setTamanhoCamera(largura: float, altura: float)
        + pollEvent(evento: sf::Event&): bool
        + getTamanho(): sf::Vector2u
        + carregarShaders()
        + tirarShader()
        + getView(): sf::View&
        + setMoveBounds(bounds: sf::FloatRect&)
        + updateCamera(playerPos: sf::Vector2f&)
        + isPlayerOutsideBounds(playerPos: sf::Vector2f&): bool
        + setIsShader(sd: bool)
    }

    class ResourceManager <<Manager>> {
        - {static} singleton: ResourceManager*
        - texturas: unordered_map<string, sf::Texture>
        - fontes: unordered_map<string, sf::Font>
        - imagens: unordered_map<string, sf::Image>
        - sons: unordered_map<string, sf::SoundBuffer>
        - musicas: unordered_map<string, sf::Music*>
        - ResourceManager()
        - ~ResourceManager()
        + {static} getInstance(): ResourceManager*
        + loadTexture(id: string, filename: string): bool
        + loadFont(id: string, filename: string): bool
        + loadImage(id: string, filename: string): bool
        + loadSons(id: string, filename: string): bool
        + loadMusic(id: string, filename: string): bool
        + getTexture(id: string): sf::Texture&
        + getFont(id: string): sf::Font&
        + getImage(id: string): sf::Image&
        + getSom(id: string): sf::SoundBuffer&
        + getMusic(id: string): sf::Music*
    }

    class CollisionManager <<Manager>> {
        - entidades: unordered_set<Entity*>
        + CollisionManager()
        + ~CollisionManager()
        + addEntity(entity: Entity*)
        + removeEntity(entity: Entity*)
        + tratarColisoes()
        + verificaColisao(a: Entity*, b: Entity*): bool
    }
}

' ===================
' CLASSE BASE ENTE
' ===================
class Ente <<Abstract>> {
    # id: int
    # {static} cont: int
    # {static} gGrafico: Renderer*
    # {static} gRecursos: ResourceManager*
    # sprite: sf::Sprite
    + Ente()
    + Ente(figura: sf::Texture&)
    + {abstract} ~Ente()
    + renderizar(camada: int)
    + getSprite(): sf::Sprite
    + setTexture(textura: sf::Texture&)
    + setSize(size: sf::Vector2f&)
    + getOrigin(): sf::Vector2f
    + getId(): int
}

' ===================
' SISTEMA DE FÍSICA
' ===================
class PhysicsComponent <<Component>> {
    - {static} gravidade: float
    - velocidade: sf::Vector2f*
    - posicao: sf::Vector2f*
    - estaNoChao: bool
    - pulando: bool
    - forcaPulo: float
    + PhysicsComponent(position: sf::Vector2f*, speed: sf::Vector2f*, fPulo: float)
    + ~PhysicsComponent()
    + aplicaFisica(deltaTime: float)
    + setNoChao(estado: bool)
    + getNoChao(): bool
    + pular(forcaPulo: float)
}

' ===================
' SISTEMA DE ANIMAÇÃO
' ===================
class Animation <<Component>> {
    - frames: vector<sf::IntRect>
    - spriteSheet: sf::Texture*
    - frameDuration: float
    - elapsedTime: float
    - currentFrame: size_t
    - isLooping: bool
    + Animation()
    + addFrame(rect: sf::IntRect&)
    + setSpriteSheet(texture: sf::Texture&)
    + setFrameDuration(duration: float)
    + setLooping(loop: bool)
    + update(deltaTime: float)
    + applyToSprite(sprite: sf::Sprite&)
}

' ===================
' ENTIDADES DO JOGO
' ===================
class Entity <<Entity>> {
    # posicao: sf::Vector2f
    # velocidade: sf::Vector2f
    # colisao: bool
    # hitBox: sf::RectangleShape
    # fisica: PhysicsComponent
    # hitBoxSize: sf::Vector2f
    # hitBoxOffset: sf::Vector2f
    + Entity(x: int, y: int)
    + Entity(textura: sf::Texture&, x: int, y: int, colide: bool)
    + {abstract} ~Entity()
    + {abstract} executar(deltaTime: float)
    + getHitBox(): sf::RectangleShape&
    + setPosicao(x: int, y: int)
    + setPosicao(novaPosicao: sf::Vector2f)
    + getPosicao(): sf::Vector2f
    + setOrigin()
    + criarHitBox()
    + setHitBoxSize(size: sf::Vector2f)
    + setHitBoxOffset(offset: sf::Vector2f)
    + atualizaHitBox()
    + setNoChao(noChao: bool)
    + getNoChao(): bool
    + {abstract} colidiu(other: Entity*)
    + colidiuComTile(e: Entity*)
    + getColisao(): bool
}

class Character <<Entity>> {
    - vida: int
    - ataque: int
    + Character(textura: sf::Texture&, x: int, y: int, life: int, atack: int)
    + {abstract} ~Character()
    + executar(deltaTime: float)
}

class Player <<Entity>> {
    - pontos: int
    - velocidadeHorizontal: float
    - walkAnimation: Animation
    - idleAnimation: Animation
    - currentAnimation: Animation*
    - isMoving: bool
    + Player(textura: sf::Texture&, x: int, y: int, life: int, atack: int, points: int)
    + ~Player()
    + executar(deltaTime: float)
    + colidiu(other: Entity*)
    + pular()
}

' ===================
' SISTEMA DE TILES
' ===================
namespace TileEngine {
    class TileEntity <<Entity>> {
        - id: int
        + TileEntity(textura: sf::Texture&, x: int, y: int, xTile: int, yTile: int, tileSize: int, colide: bool)
        + ~TileEntity()
        + executar(deltaTime: float)
        + colidiuComTile(e: Entity*)
        + colidiu(e: Entity*)
    }

    class TileMap <<Manager>> {
        - tileSize: int
        - height: int
        - width: int
        - matrizTiles: vector<vector<int>>
        - matrizEntidades: vector<vector<TileEntity*>>
        - coordenadas: vector<vector<sf::Vector2f>>
        - lTiles: vector<TileEntity*>
        - sheet: sf::Texture
        + TileMap()
        + ~TileMap()
        + loadMapFromFile(filename: string)
        + loadSheet(textura: sf::Texture&)
        + getEntitys(): vector<Entity*>
        + getOrigem(): sf::Vector2f
        + atualizarCoordenadas(view: sf::View&)
        + atualizarTiles()
        + atualizarMapa(camera: sf::View&)
        + moverColunas(direcao: int)
    }
}

' ===================
' SISTEMA DE PARALAXE
' ===================
struct Camada <<Utility>> {
    sprite: sf::Sprite[2]
    velocidade: float
    camada: float
}

class Parallax <<Utility>> {
    - layers: vector<Camada*>
    - lastCameraPosition: sf::Vector2f
    - multiplicadorParalax: float
    + Parallax()
    + ~Parallax()
    + addLayer(textura: sf::Texture&, speed: float, camada: int)
    + atualizar(camera: sf::View&)
    + renderizar()
    + setPosition(origem: sf::Vector2f)
    + estenderLayer(camera: sf::View&)
}

' ===================
' SISTEMA DE CENAS
' ===================
abstract class Scene <<Scene>> {
    + janela: Renderer*
    + gRecursos: ResourceManager*
    + tempo: sf::Clock
    + deltaTime: float
    + Scene()
    + {abstract} ~Scene()
    + {abstract} inicializar()
    + {abstract} finalizar()
    + {abstract} executar()
    + {abstract} renderizar()
    + {abstract} processarEventos(evento: sf::Event&)
    + pausar()
    + retomar()
}

class SceneManager <<Manager>> {
    - {static} singleton: SceneManager*
    - cenas: stack<unique_ptr<Scene>>
    - fadeShape: sf::RectangleShape
    - fadeOpacity: float
    - fadingIn: bool
    - fadingOut: bool
    - nextScene: unique_ptr<Scene>
    - SceneManager()
    - startFadeIn()
    - startFadeOut(novaCena: unique_ptr<Scene>)
    + ~SceneManager()
    + {static} getInstance(): SceneManager*
    + mudarCena(novaCena: unique_ptr<Scene>)
    + empilharCena(novaCena: unique_ptr<Scene>)
    + desempilharCena()
    + atualizarCenaAtual()
    + renderizarCenaAtual()
    + processarEventosCenaAtual(evento: sf::Event&)
}

class MenuScene <<Scene>> {
    - background: sf::Sprite
    - button: sf::Sprite[2]
    - select: sf::Sprite[2]
    - music: sf::Music*
    - selectedButton: int
    - selecionarBotao(index: int)
    + MenuScene()
    + ~MenuScene()
    + inicializar()
    + executar()
    + renderizar()
    + processarEventos(evento: sf::Event&)
    + finalizar()
}

class GameScene <<Scene>> {
    - gColisao: CollisionManager
    - map: TileMap
    - cenario: Parallax
    - player: Player*
    - lEntidades: vector<Entity*>
    - musica: sf::Music*
    + GameScene()
    + ~GameScene()
    + inicializar()
    + executar()
    + renderizar()
    + finalizar()
    + processarEventos(evento: sf::Event&)
}

class CreditsScene <<Scene>> {
    - creditsText: sf::Text
    - font: sf::Font
    - background: sf::RectangleShape
    - clock: sf::Clock
    - music: sf::Music*
    - elapsedTime: float
    + CreditsScene()
    + ~CreditsScene()
    + inicializar()
    + executar()
    + renderizar()
    + processarEventos(evento: sf::Event&)
    + finalizar()
}

' ===================
' CLASSE PRINCIPAL
' ===================
class Game <<Manager>> {
    - janela: Renderer*
    - gCenas: SceneManager*
    - cenaJogo: GameScene*
    + Game()
    + ~Game()
    + executar()
}

' ===================
' RELACIONAMENTOS
' ===================

' Herança
Ente <|-- Entity
Ente <|-- Parallax
Entity <|-- Character
Entity <|-- TileEngine.TileEntity
Character <|-- Player
Scene <|-- MenuScene
Scene <|-- GameScene
Scene <|-- CreditsScene

' Composição e Agregação
Entity *-- PhysicsComponent
Player *-- Animation
Parallax *-- Camada
TileEngine.TileMap *-- TileEngine.TileEntity
SceneManager *-- Scene
Game *-- Gerenciador.Renderer
Game *-- SceneManager
GameScene *-- Gerenciador.CollisionManager
GameScene *-- TileEngine.TileMap
GameScene *-- Parallax
GameScene *-- Player

' Dependências
Ente ..> Gerenciador.Renderer
Ente ..> Gerenciador.ResourceManager
Scene ..> Gerenciador.Renderer
Scene ..> Gerenciador.ResourceManager
Gerenciador.CollisionManager ..> Entity

' Singletons
Gerenciador.Renderer : <<Manager>>
Gerenciador.ResourceManager : <<Manager>>
SceneManager : <<Manager>>

' Legenda de cores
note top : **LEGENDA DE CORES**\n🔵 **AZUL** - Managers/Singletons\n🟢 **VERDE** - Components\n🟠 **LARANJA** - Entities\n🟣 **ROXO** - Scenes\n⚪ **CINZA** - Utilities\n🔴 **VERMELHO** - Abstract Classes

@enduml